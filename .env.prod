# ===============================
# ENV
# ===============================
ENV=PROD

# ===============================
# DATABASE
# ===============================
DB_HOST=10.1.74.201
DB_PORT=3306
DB_USER=digipay_new
DB_PASSWORD=B2tc6fJhZRKq1Dj
DB_NAME=npci

# ===============================
# JWT
# ===============================
JWT_SECRET=hVp48q32qel5J1bJutBWIVKsO4f1FbgA3SwS1lXsoi8=
JWT_EXPIRY_SECONDS=21600

# ===============================
# REDIS
# ===============================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=1

# ===============================
# RATE LIMIT
# ===============================
RATE_LIMIT=100
RATE_WINDOW=60

# ===============================
# API DEPRECATION GOVERNANCE
# ===============================
DEPRECATED_API_VERSION=v1
API_SUNSET_DATE=2026-12-31

# Behaviour flags
DEPRECATION_BLOCK_AFTER_SUNSET=true
DEPRECATION_WARN_BEFORE_SUNSET=true

# ===============================
# PER-ENDPOINT API DEPRECATION
# ===============================
API_DEPRECATION_RULES_JSON={"\/api\/v1\/passbook":{"sunset":"2026-12-31","block":true},"\/api\/v1\/txn-logs":{"sunset":"2026-10-01","block":true},"\/api\/v1\/wallet\/balance":{"sunset":"2027-01-01","block":false}}

# ===============================
# CANARY BLOCKING
# ===============================
DEPRECATION_CANARY_PERCENT=1

# ===============================
# OPENAPI CHANGELOG
# ===============================
API_CHANGELOG_JSON={"v1":[{"date":"2024-01-15","type":"non-breaking","description":"Initial public release","ticket":"DGP-1001"},{"date":"2025-09-01","type":"deprecated","description":"Marked v1 as deprecated, migrate to v2","ticket":"DGP-2214"}],"v2":[{"date":"2025-09-01","type":"breaking","description":"New transaction schema and pagination","ticket":"DGP-2215"}]}

# ===============================
# INTERNAL AUTH BYPASS  
# ===============================
ENABLE_INTERNAL_AUTH_BYPASS=true
# AI_PLATFORM is required for the assistant's read-only calls to the legacy API.
INTERNAL_CLIENTS=WALLET_SERVICE,PASSBOOK_SERVICE,LOG_SERVICE,AI_PLATFORM
INTERNAL_BYPASS_SECRET=NPCI_INT3RNAL_Bypass_Secr3t_2026!

# ===============================
# ENTERPRISE AI PLATFORM (DAP)
# ===============================
ENVIRONMENT=prod
DEBUG=false
OPENAI_API_KEY=your_production_openai_api_key_here
GEMINI_API_KEY=your_production_gemini_api_key_here
# DigiPay Spring Boot gateway-service (PRODUCTION).
#
#   production   https://digipayapi.csccloud.in
#   uat / local  https://digipayapiuat.csccloud.in     (see .env.local)
#
# Same host the React app uses as VITE_API_BASE_URL. HTTPS only; port 80 closed.
#
# The /gateway context path is appended automatically from
# API_GATEWAY_CONTEXT_PATH, so this value works with or without it.
API_GATEWAY_URL=https://digipayapi.csccloud.in
API_GATEWAY_CONTEXT_PATH=/gateway
API_GATEWAY_HEALTH_PATH=/actuator/health
ZIPKIN_BASE_URL=http://zipkin:9411
REDIS_URL=redis://redis:6379/1
LLM_PROVIDER=openai
OLLAMA_URL=http://ollama:11434
ENABLE_TRACING=true
ENABLE_METRICS=true
ENABLE_REQUEST_LOGGING=true
