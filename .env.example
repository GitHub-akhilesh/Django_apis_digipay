# DigiPay API Gateway Environment Configuration Template

ENV=LOCAL
LOG_LEVEL=INFO

# Application Security Secrets
JWT_SECRET_KEY=CHANGE_THIS_SECRET_KEY_FOR_PRODUCTION_USE
SECRET_KEY=CHANGE_THIS_GENERAL_SECRET_KEY
SECURITY_BYPASS_SECRET=NPCI_INT3RNAL_Bypass_Secr3t_2026!

# Database Connections
DATABASE_URL=sqlite+aiosqlite:///./digipay.db
REDIS_URL=redis://127.0.0.1:6379/0

# Rate Limiting & Auth Controls
ENABLE_INTERNAL_AUTH_BYPASS=true
INTERNAL_CLIENTS=WALLET_SERVICE,PASSBOOK_SERVICE,LOG_SERVICE,SETTLEMENT_SERVICE

# LangChain / LangGraph Observability (Optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
