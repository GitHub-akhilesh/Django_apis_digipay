# ===============================
# INTERNAL AUTH BYPASS  
# ===============================
ENABLE_INTERNAL_AUTH_BYPASS=true
# AI_PLATFORM is required so the assistant's read-only service-to-service calls
# to the legacy API (/api/v1/txn-logs, /passbook, /wallet_balance) authenticate.
# It is listed under its own name rather than reusing an existing client id, so
# the legacy service's audit log attributes those calls correctly.
INTERNAL_CLIENTS=WALLET_SERVICE,PASSBOOK_SERVICE,LOG_SERVICE,AI_PLATFORM
INTERNAL_BYPASS_SECRET=NPCI_INT3RNAL_Bypass_Secr3t_2026!


# ===============================
# ENTERPRISE AI PLATFORM (DAP)
# ===============================
ENVIRONMENT=local
DEBUG=true
OPENAI_API_KEY=
GEMINI_API_KEY=
# DigiPay Spring Boot gateway-service (UAT).
#
#   production   https://digipayapi.csccloud.in       (see .env.prod)
#   uat / local  https://digipayapiuat.csccloud.in
#
# Same host the React app uses as VITE_API_BASE_URL. HTTPS only; port 80 is
# closed on both hosts.
#
# The /gateway context path is added automatically from
# API_GATEWAY_CONTEXT_PATH, so this value may be given with or without it —
# whichever you paste, calls resolve to https://<host>/gateway/v2/...
# (gateway-service sets server.servlet.context-path=/gateway; a missing or
# doubled prefix both produce a Tomcat HTML 404.)
#
# Local development points at UAT deliberately: the assistant only ever issues
# read-only calls (enforced by the allow-list in gateway/v2/safety.py), and
# pointing a dev machine at production would be a mistake waiting to happen.
API_GATEWAY_URL=https://digipayapiuat.csccloud.in
API_GATEWAY_CONTEXT_PATH=/gateway
API_GATEWAY_HEALTH_PATH=/actuator/health
ZIPKIN_BASE_URL=http://localhost:9411
REDIS_URL=redis://127.0.0.1:6379/2
LLM_PROVIDER=openai
OLLAMA_URL=http://localhost:11434
ENABLE_TRACING=true
ENABLE_METRICS=true
ENABLE_REQUEST_LOGGING=true

# ===============================
# DIGIPAY SPRING BOOT GATEWAY (gateway-service)
# ===============================
# API_GATEWAY_URL above is the base for the /v2/* and /v1/upi/* controllers.
#
# GET /v2/ledger/balance sends an X-Frontend-Key header. That header is NOT a
# shared secret copied from the gateway — it is THIS platform's own RSA public
# key, which the gateway uses to encrypt the balance back to us
# (com.digipay.common.utils.Crypto#encryptForFrontend).
#
# The keypair below is generated automatically on first use. Keep the file across
# restarts, or point this at a mounted secret — if the key changes between the
# request and the response the balance cannot be decrypted.
GATEWAY_CLIENT_KEY_PATH=data/keys/gateway_client_rsa.pem
GATEWAY_CLIENT_KEY_SIZE=2048

# Verify the backend's SHA256withRSA signature on encrypted responses. The
# verifying key is fetched from GET /v2/user/publickey at runtime, so nothing
# from backend-keystore.p12 needs to be copied into this project.
GATEWAY_VERIFY_RESPONSE_SIGNATURE=true

# ===============================
# RAG KNOWLEDGE STORE (MongoDB)
# ===============================
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=digipay_ai
MONGO_RAG_DOCS_COLLECTION=rag_documents
MONGO_RAG_CHUNKS_COLLECTION=rag_chunks

# Set true only on MongoDB Atlas with a vector index named below.
# On standalone MongoDB leave false: cosine similarity is computed in-process.
MONGO_VECTOR_SEARCH_ENABLED=false
MONGO_VECTOR_INDEX=rag_chunk_vector_index

RAG_ENABLED=true
RAG_AUTO_SEED=true
RAG_TOP_K=4
RAG_CANDIDATE_POOL=60
RAG_MIN_SCORE=0.05

# auto = OpenAI embeddings when OPENAI_API_KEY is set, else the deterministic
# hashing embedder (no API key, no model download, lexical similarity).
RAG_EMBEDDING_PROVIDER=auto
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBEDDING_DIM=512


