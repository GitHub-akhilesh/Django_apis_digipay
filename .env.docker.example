# =============================================================================
# Docker Compose environment template.
#
#   cp .env.docker.example .env.docker
#   docker compose --env-file .env.docker up --build
#
# Deliberately NOT named `.env`: both applications also read a root `.env` via
# pydantic-settings, so a compose file living there would silently change the
# configuration of a local (non-Docker) run. Passing it explicitly with
# --env-file keeps Docker's substitution variables separate from application
# configuration.
#
# The variables marked REQUIRED use the `${VAR:?}` form in docker-compose.yml,
# so the stack fails fast with a clear message rather than starting misconfigured.
#
# `.env.docker` is gitignored — keep real secrets out of version control.
# =============================================================================

# -------------------------------------------------------------- REQUIRED
# This file is a TEMPLATE and is committed. Never put real values here — copy it
# to .env.docker (gitignored) and fill them in there.
#
# Must be IDENTICAL for both services: a token minted by one is verified by the
# other, so a mismatch produces 401s that look like an auth bug. Use the same
# value the DigiPay gateway signs its session tokens with.
JWT_SECRET=CHANGE_ME_same_as_digipay_gateway

# Shared secret for the assistant's read-only service-to-service calls to the
# legacy API. Must match the legacy service's INTERNAL_BYPASS_SECRET.
INTERNAL_BYPASS_SECRET=CHANGE_ME_same_as_legacy_api

# -------------------------------------------------------------- optional
ENV=LOCAL
ENVIRONMENT=local

# Legacy API database. Defaults to SQLite on a named volume so the stack comes
# up with no database server — but that file is EMPTY, so every legacy answer is
# structurally valid and blank (a Rs 0.00 wallet balance for an account that has
# history). Point this at the npci MySQL for real data: the wallet balance sums
# the `transactions` table and the passbook needs the sharded
# `digipay_ledger_<n>` tables, which only exist there.
# DATABASE_URL=mysql+aiomysql://USER:URL_ENCODED_PASSWORD@HOST:3306/npci

# AI_PLATFORM must stay in this list or the assistant's legacy calls get 401.
INTERNAL_CLIENTS=WALLET_SERVICE,PASSBOOK_SERVICE,LOG_SERVICE,AI_PLATFORM

# DigiPay Spring Boot gateway-service. This is the SAME host the React app uses
# as VITE_API_BASE_URL.
#
#   production   https://digipayapi.csccloud.in
#   uat / local  https://digipayapiuat.csccloud.in
#
# Both hosts are HTTPS only. The /gateway context path is appended automatically
# from API_GATEWAY_CONTEXT_PATH, so either spelling of the URL works.
#
# Use http://host.docker.internal:8080 instead to target a gateway running on
# your own machine (with API_GATEWAY_CONTEXT_PATH left as /gateway).
API_GATEWAY_URL=https://digipayapiuat.csccloud.in
API_GATEWAY_CONTEXT_PATH=/gateway

# /health on the gateway is behind Spring Security and answers 401; the actuator
# endpoint is the one that is publicly readable.
API_GATEWAY_HEALTH_PATH=/actuator/health

# Legacy DigiPay API service.
#
# By default the compose stack runs its OWN legacy-api container and the AI
# platform talks to it at http://legacy-api:8000. To read real data instead,
# point both variables at the deployed instance:
#
#   LEGACY_API_URL=http://10.1.76.194
#   LEGACY_API_PUBLIC_URL=http://10.1.76.194
#
# Note: the deployed legacy service must list AI_PLATFORM in its INTERNAL_CLIENTS
# or the assistant's read-only calls return 401 (see docs/operations/ENVIRONMENTS.md).
# LEGACY_API_URL=http://10.1.76.194

# Browser-facing address shown in the merged Swagger schema so "Try it out"
# works. Inside the compose network the services talk over http://legacy-api:8000,
# which a browser cannot resolve, so this must be a host the browser can reach.
LEGACY_API_PUBLIC_URL=http://localhost:8000

# Leave empty to use the offline keyword router and lexical RAG embeddings.
# Set a real key before serving users.
OPENAI_API_KEY=
LLM_PROVIDER=openai

MONGO_DB=digipay_ai
